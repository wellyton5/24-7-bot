load_dotenv()

# Configurações do Bot
TOKEN = os.getenv("DISCORD_TOKEN")
BAN_CHANNEL_ID = os.getenv("BAN_CHANNEL")
BASE_RADIUS = os.getenv("BASE_RADIUS", 50)  # Raio de proteção da base em metros
STATE_FILE = "bot_state.json"
