# 24/7 Security Bot - Configuration Template
# Copy to .env and fill with your real credentials

# Discord Bot
DISCORD_TOKEN=
ADMIN_PASSWORD=

# Discord Channels
BAN_CHANNEL=
KILLFEED_CHANNEL=
